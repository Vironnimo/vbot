class Database:
    def __init__(
        self,
        spec: Any,
        runtime: Any,
        *,
        database_id: str,
        data_dir: Path | None,
        workers: Any | None = ...,
        restore_id: str | None = ...,
    ) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def path(self) -> Path: ...
    @property
    def database_id(self) -> str: ...
    @property
    def data_dir(self) -> Path | None: ...
    @property
    def restore_id(self) -> str | None: ...
    @property
    def writer(self) -> sqlite3.Connection: ...
    def read(self) -> contextlib.AbstractContextManager[sqlite3.Connection]: ...
    def write[Result](
        self, operation: Callable[[sqlite3.Connection], Result], *, patience_s: float = ...
    ) -> Result: ...
    async def run_async[Result](
        self, function: Callable[..., Result], *arguments: Any, **keyword_arguments: Any
    ) -> Result: ...
    async def read_async[Result](
        self, operation: Callable[[sqlite3.Connection], Result], *, patience_s: float = ...
    ) -> Result: ...
    async def write_async[Result](
        self, operation: Callable[[sqlite3.Connection], Result], *, patience_s: float = ...
    ) -> Result: ...
    def backup(self, destination: Path, *, cancelled: Callable[[], bool] | None = ...) -> bool: ...
    def checkpoint(self) -> None: ...
    def verify_read_write(self) -> None: ...
    def health(self) -> Any: ...
    def wal_active(self) -> bool: ...
    def reader_stats(self) -> tuple[int, int]: ...
    def live_connection_count(self) -> int: ...
    def is_closed(self) -> bool: ...
    def close(self) -> None: ...

class DatabaseError(Exception): ...

