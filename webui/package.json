{
  "name": "vbot-webui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-extension-pages.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "format": "prettier --ignore-unknown --config prettier.config.js --plugin prettier-plugin-svelte --write src scripts \"../resources/extensions/*/ui/**/*\" \"../tests/fixtures/extension-pages/*/ui/**/*\"",
    "format:check": "prettier --ignore-unknown --config prettier.config.js --plugin prettier-plugin-svelte --check src scripts \"../resources/extensions/*/ui/**/*\" \"../tests/fixtures/extension-pages/*/ui/**/*\"",
    "lint": "cd .. && eslint --config webui/eslint.config.js webui/src webui/scripts \"resources/extensions/*/ui/**/*.{js,mjs,cjs,svelte}\" \"tests/fixtures/extension-pages/*/ui/**/*.{js,mjs,cjs,svelte}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^17.0.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^4.0.0",
    "svelte": "^5.0.0",
    "terser": "^5.49.2",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/svelte": "^0.5.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "cronstrue": "^3.14.0",
    "markdown-it": "^15.0.0"
  }
}
