#!/bin/sh
# Check a merge commit like any other commit: refuse an AI tool identity
# (scripts/commit_authorship.py), then run scripts/commit_check.py.
# Enable once per clone: git config core.hooksPath .githooks
PYTHON=python
command -v python >/dev/null 2>&1 || PYTHON=python3
"$PYTHON" scripts/commit_authorship.py identity || exit 1
exec "$PYTHON" scripts/commit_check.py
