{
  "format_version": 1,
  "_comment": "MiniMax. API-key Connections speak Chat Completions; subscription speaks Anthropic Messages. New Chat Models infer the M3.1 effort ladder, mandatory thinking, current output-limit field and temperature range; exact older M2/M3 rules preserve split traces, control and request behavior. The Messages wire takes no Claude thinking controls and no media and replays only signed thinking blocks (the Messages default meta_only). Both wires document a 64 MB request body limit. Inferred defaults follow https://platform.minimax.io/docs/api-reference/text-chat-openai (2026-10-15), not a live verification.",
  "defaults": {
    "request": {
      "parameters": {
        "temperature": {
          "minimum": 0,
          "exclusive_minimum": true,
          "maximum": 1,
          "out_of_range": "reject"
        }
      }
    },
    "media": {"request_max_bytes": 64000000}
  },
  "protocols": {
    "chat_completions": {
      "request": {
        "output_limit_field": "max_completion_tokens",
        "output_limit_collapse": true,
        "parameters": {
          "temperature": {"exclusive_minimum": false, "maximum": 2},
          "reasoning": {"mode": "drop"},
          "reasoning_effort": {"mode": "drop"},
          "include_reasoning": {"mode": "drop"},
          "thinking": {"mode": "drop"}
        }
      },
      "reasoning": {
        "dialect": "reasoning_effort",
        "floor": ["low", "medium", "high", "xhigh", "max"],
        "off": "lowest"
      }
    },
    "messages": {
      "request": {
        "prompt_cache": "anthropic_breakpoints",
        "parameters": {
          "thinking": {"mode": "drop"},
          "output_config": {"mode": "drop"},
          "reasoning_split": {"mode": "drop"},
          "reasoning_effort": {"mode": "drop"}
        }
      },
      "reasoning": {"dialect": "none"},
      "media": {"types": []}
    }
  },
  "connections": {
    "subscription": {"protocol": "messages"}
  },
  "rules": [
    {
      "when": {
        "ids": [
          "MiniMax-M2",
          "MiniMax-M2.1",
          "MiniMax-M2.1-highspeed",
          "MiniMax-M2.5",
          "MiniMax-M2.5-highspeed",
          "MiniMax-M2.7",
          "MiniMax-M2.7-highspeed"
        ],
        "connections": ["api-key", "api-key-cn"]
      },
      "set": {
        "request": {
          "output_limit_field": "max_tokens",
          "output_limit_collapse": false,
          "parameters": {"temperature": {"exclusive_minimum": true, "maximum": 1}}
        },
        "reasoning": {"dialect": "minimax_split", "floor": ["low", "medium", "high"], "off": "auto"}
      },
      "note": "M2.x takes no reasoning control; retain its split trace instead of applying the M3.1 effort default."
    },
    {
      "when": {"ids": ["MiniMax-M3"], "connections": ["api-key", "api-key-cn"]},
      "set": {
        "request": {
          "output_limit_field": "max_tokens",
          "output_limit_collapse": false,
          "parameters": {
            "thinking": {"mode": "send"},
            "temperature": {"exclusive_minimum": true, "maximum": 1}
          }
        },
        "reasoning": {"dialect": "minimax_thinking", "floor": ["low", "medium", "high"], "off": "auto"}
      },
      "note": "M3 switches thinking between adaptive and disabled; no effort level or budget reaches the wire."
    }
  ]
}
