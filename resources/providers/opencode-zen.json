{
  "id": "opencode-zen",
  "name": "OpenCode Zen",
  "adapter": "opencode_zen",
  "base_url": "https://opencode.ai/inference/v1",
  "connections": [
    {
      "id": "api-key",
      "type": "api_key",
      "label": "API Key",
      "auth": {
        "header": "Authorization",
        "prefix": "Bearer ",
        "credential_key": "OPENCODE_API_KEY"
      },
      "models_endpoint": "/models",
      "catalog_requires_credentials": false
    },
    {
      "id": "account",
      "type": "oauth",
      "label": "OpenCode Account",
      "auth": {
        "header": "Authorization",
        "prefix": "Bearer "
      },
      "oauth": {
        "flow": "device",
        "device_flow": "opencode_oauth",
        "client_id": "opencode-cli",
        "device_auth_url": "https://opencode.ai/console/auth/device/code",
        "token_url": "https://opencode.ai/console/auth/device/token",
        "scopes": []
      },
      "models_endpoint": "/models",
      "catalog_requires_credentials": false
    }
  ],
  "defaults": {
    "max_tokens": 8192
  },
  "extra_headers": {
    "User-Agent": "vBot"
  },
  "models_endpoint": "/models",
  "models_dev_id": "opencode",
  "catalog_exclusions": [
    "fledge-alpha-free",
    "longcat-2.5-preview-free",
    "mimo-v2.6-flash-free",
    "jev-1.13-free",
    "jev-1.13",
    "claude-opus-4-1",
    "kimi-k2.5",
    "minimax-m2.5",
    "gpt-5.2-codex",
    "gpt-5.1-codex",
    "gpt-5.1-codex-max",
    "gpt-5.1-codex-mini",
    "gpt-5-codex",
    "claude-sonnet-4",
    "glm-5"
  ]
}
