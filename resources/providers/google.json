{
  "id": "google",
  "name": "Google AI Studio",
  "adapter": "google",
  "base_url": "https://generativelanguage.googleapis.com/v1beta",
  "connections": [
    {
      "id": "api-key",
      "type": "api_key",
      "label": "API Key",
      "auth": {
        "header": "x-goog-api-key",
        "prefix": "",
        "credential_key": "GEMINI_API_KEY"
