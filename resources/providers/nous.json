{
  "id": "nous",
  "name": "Nous Portal",
  "adapter": "nous",
  "base_url": "https://inference-api.nousresearch.com/v1",
  "connections": [
    {
      "id": "api-key",
      "type": "api_key",
      "label": "API Key / Portal Credits",
      "auth": {
        "header": "Authorization",
        "prefix": "Bearer ",
        "credential_key": "NOUS_API_KEY"
      },
      "models_endpoint": "/models"
    },
    {
      "id": "subscription",
      "type": "oauth",
      "label": "Nous Portal Login (Subscription)",
      "auth": {
        "header": "Authorization",
        "prefix": "Bearer "
      },
      "oauth": {
        "flow": "device",
        "device_flow": "nous_oauth",
        "client_id": "hermes-cli",
        "device_auth_url": "https://portal.nousresearch.com/api/oauth/device/code",
        "token_url": "https://portal.nousresearch.com/api/oauth/token",
        "scopes": ["inference:invoke"]
      },
      "models_endpoint": "/models"
    }
  ],
  "defaults": {
    "max_tokens": 32000,
    "temperature": 0.7
  },
  "context_window": 128000
}
