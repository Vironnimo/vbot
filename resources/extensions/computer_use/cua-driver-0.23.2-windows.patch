+// Query numeric owner tables instead of localized netstat output. Retain the
+// exact loopback-address and process-owner restrictions used by the proof.
+fn native_loopback_listeners(allowed_pids: &[u32]) -> Result<Vec<(u16, u32)>, BrowserRefusal> {
+    use windows::Win32::NetworkManagement::IpHelper::{
+        GetExtendedTcpTable, MIB_TCP6ROW_OWNER_PID, MIB_TCPROW_OWNER_PID,
+        TCP_TABLE_OWNER_PID_LISTENER,
+    };
+    let mut listeners = Vec::new();
+    for family in [2u32, 23u32] {
+        let mut size = 0u32;
+        // DWORD storage supplies the table and row alignment required by Win32.
+        let mut buffer = Vec::<u32>::new();
+        let mut success = false;
+        for _ in 0..4 {
+            let result = unsafe {
+                GetExtendedTcpTable(
+                    if buffer.is_empty() {
+                        None
+                    } else {
+                        Some(buffer.as_mut_ptr().cast())
+                    },
+                    &mut size,
+                    false,
+                    family,
+                    TCP_TABLE_OWNER_PID_LISTENER,
+                    0,
+                )
+            };
+            if result == 0 && !buffer.is_empty() {
+                success = true;
+                break;
+            }
+            if result != 122 || size > 64 * 1024 * 1024 {
+                return Err(refusal(
+                    BrowserRefusalCode::BrowserRouteUnavailable,
+                    format!("could not inspect native browser listeners: {result}"),
+                ));
+            }
+            buffer.resize((size as usize + 3) / 4, 0);
+        }
+        if !success {
+            return Err(refusal(
                 BrowserRefusalCode::BrowserRouteUnavailable,
-                format!("could not inspect browser listeners: {error}"),
-            )
-        })?;
-    Ok(parse_netstat_loopback_listeners(
-        &String::from_utf8_lossy(&output.stdout),
-        allowed_pids,
-    ))
+                "native browser listener table kept changing",
+            ));
+        }
+        let count = buffer[0] as usize;
+        let row_size = if family == 2 {
+            std::mem::size_of::<MIB_TCPROW_OWNER_PID>()
+        } else {
+            std::mem::size_of::<MIB_TCP6ROW_OWNER_PID>()
+        };
+        if size < 4 || count > (size as usize - 4) / row_size {
+            return Err(refusal(
+                BrowserRefusalCode::BrowserRouteUnavailable,
+                "invalid native browser listener table",
+            ));
+        }
+        for index in 0..count {
+            let row = unsafe { buffer.as_ptr().cast::<u8>().add(4 + index * row_size) };
+            let (loopback, port, pid, state) = if family == 2 {
+                let row = unsafe { &*row.cast::<MIB_TCPROW_OWNER_PID>() };
+                (
+                    row.dwLocalAddr.to_ne_bytes() == [127, 0, 0, 1],
+                    row.dwLocalPort,
+                    row.dwOwningPid,
+                    row.dwState,
+                )
+            } else {
+                let row = unsafe { &*row.cast::<MIB_TCP6ROW_OWNER_PID>() };
+                (
+                    std::net::Ipv6Addr::from(row.ucLocalAddr).is_loopback(),
+                    row.dwLocalPort,
+                    row.dwOwningPid,
+                    row.dwState,
+                )
+            };
+            if loopback && state == 2 && allowed_pids.contains(&pid) {
+                listeners.push((u16::from_be(port as u16), pid));
+            }
+        }
+    }
+    listeners.sort_unstable();
+    listeners.dedup();
+    Ok(listeners)
+}
