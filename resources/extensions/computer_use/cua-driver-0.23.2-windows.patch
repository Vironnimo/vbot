+async fn netstat_loopback_listeners(allowed_pids: &[u32]) -> Result<Vec<(u16, u32)>, BrowserRefusal> {
+    let owned = allowed_pids.to_vec();
+    tokio::task::spawn_blocking(move || native_loopback_listeners(&owned)).await
+        .map_err(|error| refusal(BrowserRefusalCode::BrowserRouteUnavailable,
+            format!("could not inspect native browser listeners: {error}")))?
+}
