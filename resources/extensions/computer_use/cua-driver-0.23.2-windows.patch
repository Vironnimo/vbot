+#[cfg(test)]
+mod native_listener_tests {
+    use super::native_loopback_listeners;
+
+    #[test]
+    fn owns_only_requested_process_loopback_listeners() {
+        let listener = std::net::TcpListener::bind("127.0.0.1:0").unwrap();
+        let port = listener.local_addr().unwrap().port();
+        let pid = std::process::id();
+        assert!(native_loopback_listeners(&[pid])
+            .unwrap()
+            .contains(&(port, pid)));
+        assert!(!native_loopback_listeners(&[])
+            .unwrap()
+            .iter()
+            .any(|(p, _)| *p == port));
+        drop(listener);
+        assert!(!native_loopback_listeners(&[pid])
+            .unwrap()
+            .contains(&(port, pid)));
+    }
+
+    #[test]
+    fn owns_ipv6_loopback_listener() {
+        let listener = std::net::TcpListener::bind("[::1]:0").unwrap();
+        let port = listener.local_addr().unwrap().port();
+        let pid = std::process::id();
+        assert!(native_loopback_listeners(&[pid])
+            .unwrap()
+            .contains(&(port, pid)));
+    }
+
+    #[test]
+    fn refuses_wildcard_listener() {
+        let listener = std::net::TcpListener::bind("0.0.0.0:0").unwrap();
+        let port = listener.local_addr().unwrap().port();
+        assert!(!native_loopback_listeners(&[std::process::id()])
+            .unwrap()
+            .iter()
+            .any(|(p, _)| *p == port));
+    }
