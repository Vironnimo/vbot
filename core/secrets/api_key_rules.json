{
  "minimum_entropy": 3,
  "token_characters": "A-Za-z0-9_-",
  "draft_prefixes": [
    "sk-",
    "ghp_",
    "gho_",
    "ghu_",
    "ghs_",
    "ghr_",
    "github_pat_",
    "gsk_",
    "AIza",
    "sk_live_",
    "sk_test_",
    "rk_live_",
    "rk_test_",
    "xoxb-",
    "xoxp-"
  ],
  "rules": [
    {
      "provider": "openai",
      "name": "OPENAI_KEY",
      "pattern": "sk-(?:proj|svcacct|admin)-([A-Za-z0-9_-]{74}T3BlbkFJ[A-Za-z0-9_-]{74}|[A-Za-z0-9_-]{58}T3BlbkFJ[A-Za-z0-9_-]{58})",
      "source": "https://github.com/gitleaks/gitleaks/blob/master/cmd/generate/config/rules/openai.go"
    },
    {
      "provider": "openai",
      "name": "OPENAI_KEY",
      "pattern": "sk-([A-Za-z0-9]{20}T3BlbkFJ[A-Za-z0-9]{20})",
      "source": "https://github.com/gitleaks/gitleaks/blob/master/cmd/generate/config/rules/openai.go"
    },
    {
      "provider": "anthropic",
      "name": "ANTHROPIC_KEY",
      "pattern": "sk-ant-(?:api03|admin01)-([A-Za-z0-9_-]{93})AA",
      "source": "https://github.com/gitleaks/gitleaks/blob/master/cmd/generate/config/rules/anthropic.go"
    },
    {
      "provider": "github",
      "name": "GITHUB_TOKEN",
      "pattern": "gh[pousr]_([A-Za-z0-9]{36})",
      "source": "https://github.com/gitleaks/gitleaks/blob/master/cmd/generate/config/rules/github.go"
    },
    {
      "provider": "github",
      "name": "GITHUB_TOKEN",
      "pattern": "github_pat_([A-Za-z0-9_]{82})",
      "source": "https://github.com/gitleaks/gitleaks/blob/master/cmd/generate/config/rules/github.go"
    },
    {
      "provider": "google",
      "name": "GOOGLE_KEY",
      "pattern": "AIza([A-Za-z0-9_-]{35})",
      "source": "https://github.com/gitleaks/gitleaks/blob/master/cmd/generate/config/rules/gcp.go"
    },
    {
      "provider": "groq",
      "name": "GROQ_KEY",
      "pattern": "gsk_([A-Za-z0-9]{52})",
      "source": "https://github.com/trufflesecurity/trufflehog/blob/main/pkg/detectors/groq/groq.go"
    },
    {
      "provider": "openrouter",
      "name": "OPENROUTER_KEY",
      "pattern": "sk-or-v1-([0-9a-f]{64})",
      "source": "https://github.com/trufflesecurity/trufflehog/blob/main/pkg/detectors/openrouter/openrouter.go"
    },
    {
      "provider": "stripe",
      "name": "STRIPE_KEY",
      "pattern": "(?:sk|rk)_(?:test|live)_([A-Za-z0-9]{24,99})",
      "source": "https://github.com/gitleaks/gitleaks/blob/master/cmd/generate/config/rules/stripe.go"
    },
    {
      "provider": "slack",
      "name": "SLACK_TOKEN",
      "pattern": "xoxb-[0-9]{10,13}-[0-9]{10,13}-([A-Za-z0-9]{24,32})",
      "source": "https://github.com/gitleaks/gitleaks/blob/master/cmd/generate/config/rules/slack.go"
    },
    {
      "provider": "slack",
      "name": "SLACK_TOKEN",
      "pattern": "xoxp-[0-9]{10,13}-[0-9]{10,13}-[0-9]{10,13}-([a-f0-9]{32})",
      "source": "https://github.com/gitleaks/gitleaks/blob/master/cmd/generate/config/rules/slack.go"
    }
  ]
}
