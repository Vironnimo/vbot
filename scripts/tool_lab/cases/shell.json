    ]
   }
  },
  {
   "name": "terminal: text on wait names the input call",
   "steps": [
    {
     "tool": "terminal",
     "arguments": {
      "action": "start",
      "command": "python",
      "args": [
       "-q"
      ]
     }
    },
    {
     "tool": "terminal",
     "arguments": {
      "action": "wait",
      "terminal_id": "$1.terminal_id",
      "text": "y"
     }
    }
