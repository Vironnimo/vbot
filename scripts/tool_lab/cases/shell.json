{
 "files": {
  "sub/marker.txt": "marker\n"
 },
 "cases": [
  {
   "name": "shell: canonical",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"print('hello there')\""
   },
   "expect": {
    "ok": true,
    "contains": [
     "hello there"
    ]
   }
  },
  {
   "name": "shell: cmd alias",
   "tool": "bash",
   "arguments": {
    "cmd": "python -c \"print('hello there')\""
   },
   "expect": {
    "ok": true,
    "contains": [
     "hello there"
    ]
   }
  },
  {
   "name": "shell: script alias",
   "tool": "bash",
   "arguments": {
    "script": "python -c \"print('hello there')\""
   },
   "expect": {
    "ok": true,
    "contains": [
     "hello there"
    ]
   }
  },
  {
   "name": "shell: argv array (Codex)",
   "tool": "bash",
   "arguments": {
    "command": [
     "python",
     "-c",
     "print('argv ok')"
    ]
   },
   "expect": {
    "ok": true,
    "contains": [
     "argv ok"
    ]
   }
  },
  {
   "name": "shell: commands list runs in order",
   "tool": "bash",
   "arguments": {
    "commands": [
     "python -c \"print('first step')\"",
     "python -c \"print('second step')\""
    ]
   },
   "expect": {
    "ok": true,
    "contains": [
     "first step",
     "second step"
    ]
   }
  },
  {
   "name": "shell: cwd alias",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"import os; print(os.listdir('.'))\"",
    "cwd": "sub"
   },
   "expect": {
    "ok": true,
    "contains": [
     "marker.txt"
    ]
   }
  },
  {
   "name": "shell: directory alias (Gemini)",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"import os; print(os.listdir('.'))\"",
    "directory": "sub",
    "description": "list sub"
   },
   "expect": {
    "ok": true,
    "contains": [
     "marker.txt"
    ]
   }
  },
  {
   "name": "shell: working_directory alias",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"import os; print(os.listdir('.'))\"",
    "working_directory": "sub"
   },
   "expect": {
    "ok": true,
    "contains": [
     "marker.txt"
    ]
   }
  },
  {
   "name": "shell: timeout_ms",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"print('hello there')\"",
    "timeout_ms": 60000
   },
   "expect": {
    "ok": true,
    "contains": [
     "hello there"
    ],
    "absent": [
     "milliseconds"
    ]
   }
  },
  {
   "name": "shell: timeout given in ms is read as ms with a note",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"print('hello there')\"",
    "timeout": 120000
   },
   "expect": {
    "ok": true,
    "contains": [
     "hello there",
     "milliseconds"
    ]
   }
  },
  {
   "name": "shell: background true",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"import time; time.sleep(1)\"",
    "background": true
   },
   "expect": {
    "ok": true,
    "contains": [
     "status: running",
     "terminal_id"
    ]
   }
  },
  {
   "name": "shell: run_in_background (Claude Code)",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"import time; time.sleep(1)\"",
    "run_in_background": true,
    "description": "short sleep"
   },
   "expect": {
    "ok": true,
    "contains": [
     "status: running",
     "terminal_id"
    ]
   }
  },
  {
   "name": "shell: is_background with explanation (Cursor)",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"print('hello there')\"",
    "is_background": false,
    "explanation": "print a greeting"
   },
   "expect": {
    "ok": true,
    "contains": [
     "hello there"
    ]
   }
  },
  {
   "name": "shell: mode auto means foreground",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"print('hello there')\"",
    "mode": "auto"
   },
   "expect": {
    "ok": true,
    "contains": [
     "hello there"
    ]
   }
  },
  {
   "name": "shell: background conflicts with mode",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"print('hello there')\"",
    "mode": "foreground",
    "background": true
   },
   "expect": {
    "ok": false,
    "contains": [
     "mode"
    ]
   }
  },
  {
   "name": "shell: empty env_keys",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"print('hello there')\"",
    "env_keys": []
   },
   "expect": {
    "ok": true,
    "contains": [
     "hello there"
    ]
   }
  },
  {
   "name": "shell: env_keys naming an inherited variable",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"print('hello there')\"",
    "env_keys": [
     "PATH"
    ]
   },
   "expect": {
    "ok": true,
    "contains": [
     "hello there",
     "inherit"
    ]
   }
  },
  {
   "name": "shell: env_keys naming an unknown credential",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"print('hello there')\"",
    "env_keys": [
     "VBOT_PROBE_MISSING_KEY"
    ]
   },
   "expect": {
    "ok": false,
    "contains": [
     "VBOT_PROBE_MISSING_KEY",
     "not granted to this Agent"
    ],
    "absent": [
     "hello there"
    ]
   }
  },
  {
   "name": "shell: env object sets a plain variable",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"import os; print(os.environ['PROBE_GREETING'])\"",
    "env": {
     "PROBE_GREETING": "hi from env"
    }
   },
   "expect": {
    "ok": true,
    "contains": [
     "hi from env"
    ]
   }
  },
  {
   "name": "shell: env object refuses a literal secret",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"print('hello there')\"",
    "env": {
     "PROBE_API_TOKEN": "abc123secret"
    }
   },
   "expect": {
    "ok": false,
    "contains": [
     "credential values written in Tool calls"
    ],
    "absent": [
     "abc123secret",
     "hello there"
    ]
   }
  },
  {
   "name": "shell: local_shell action wrapper (OpenAI)",
   "tool": "bash",
   "arguments": {
    "action": {
     "type": "exec",
     "command": [
      "python",
      "-c",
      "import os; print(os.listdir('.'))"
     ],
     "working_directory": "sub",
     "timeout_ms": 30000,
     "env": {}
    }
   },
   "expect": {
    "ok": true,
    "contains": [
     "marker.txt"
    ]
   }
  },
  {
   "name": "shell: pty flag is ignored",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"print('hello there')\"",
    "pty": true
   },
   "expect": {
    "ok": true,
    "contains": [
     "hello there"
    ]
   }
  },
  {
   "name": "shell: timeout stops the command and names the retry",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"import time; time.sleep(5)\"",
    "timeout": 1
   },
   "expect": {
    "ok": true,
    "contains": [
     "status: stopped",
     "it was still running at the 1-second timeout",
     "run it again with a larger timeout, or 0 for no limit"
    ]
   }
  },
  {
   "name": "shell: non-zero exit is ok and names the failed program",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"import sys; print('about to fail'); sys.exit(3)\""
   },
   "expect": {
    "ok": true,
    "contains": [
     "status: exited",
     "about to fail",
     "python.exe exited with code 3"
    ],
    "absent": [
     "exit_code: 0"
    ]
   }
  },
  {
   "name": "terminal: wait for a background command",
   "steps": [
    {
     "tool": "bash",
     "arguments": {
      "command": "python -c \"import time; time.sleep(1); print('work done')\"",
      "mode": "background"
     }
    },
    {
     "tool": "terminal",
     "arguments": {
      "action": "wait",
      "terminal_id": "$1.terminal_id",
      "timeout_ms": 10000
     }
    }
   ],
   "expect": {
    "ok": true,
    "contains": [
     "work done",
     "exit_code: 0",
     "\"exited\":true"
    ]
   }
  },
  {
   "name": "terminal: wait sees a background server that keeps running",
   "steps": [
    {
     "tool": "bash",
     "arguments": {
      "command": "python -u -c \"import time; print('server ready'); time.sleep(20)\"",
      "mode": "background"
     }
    },
    {
     "tool": "terminal",
     "arguments": {
      "action": "wait",
      "terminal_id": "$1.terminal_id",
      "timeout_ms": 10000
     }
    }
   ],
   "expect": {
    "ok": true,
    "contains": [
     "server ready",
     "\"exited\":false"
    ]
   }
  },
  {
   "name": "terminal: status of a running background command",
   "steps": [
    {
     "tool": "bash",
     "arguments": {
      "command": "python -c \"import time; time.sleep(20)\"",
      "mode": "background"
     }
    },
    {
     "tool": "terminal",
     "arguments": {
      "action": "status",
      "terminal_id": "$1.terminal_id"
     }
    }
   ],
   "expect": {
    "ok": true,
    "contains": [
     "time.sleep(20)",
     "\"exited\":false"
    ]
   }
  },
  {
   "name": "terminal: kill a background command",
   "steps": [
    {
     "tool": "bash",
     "arguments": {
      "command": "python -c \"import time; time.sleep(30)\"",
      "mode": "background"
     }
    },
    {
     "tool": "terminal",
     "arguments": {
      "action": "kill",
      "terminal_id": "$1.terminal_id"
     }
    }
   ],
   "expect": {
    "ok": true,
    "contains": [
     "\"exited\":true",
     "\"stop_reason\":\"agent\""
    ]
   }
  },
