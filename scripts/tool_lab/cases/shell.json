    ]
   }
  },
  {
   "name": "terminal: Codex write_stdin shape",
   "steps": [
    {
     "tool": "terminal",
     "arguments": {
      "action": "start",
      "command": "python",
      "args": [
       "-q"
      ]
     }
    },
    {
     "tool": "terminal",
     "arguments": {
      "action": "write_stdin",
      "session_id": "$1.terminal_id",
      "chars": "print(6*7)\r",
      "yield_time_ms": 8000
     }
    }
   ],
   "expect": {
    "ok": true,
    "contains": [
     "42"
    ]
   }
  },
  {
   "name": "terminal: unknown id lists attached terminals",
   "steps": [
    {
     "tool": "terminal",
     "arguments": {
      "action": "start",
      "command": "python",
      "args": [
       "-q"
      ]
     }
    },
    {
     "tool": "terminal",
     "arguments": {
      "action": "status",
      "terminal_id": "term_missing"
     }
    }
   ],
   "expect": {
    "ok": false,
    "contains": [
