    "key": "enter",
    "lines": 30
   },
   "expect": {
    "ok": true
   }
  },
  {
   "name": "terminal: command string with arguments",
   "tool": "terminal",
   "arguments": {
    "action": "start",
    "command": "python -q"
   },
   "expect": {
    "ok": true
   }
  },
  {
   "name": "terminal: enter true submits",
   "steps": [
    {
     "tool": "terminal",
     "arguments": {
      "action": "start",
      "command": "python"
     }
    },
    {
     "tool": "terminal",
     "arguments": {
      "action": "input",
