    ]
   }
  },
  {
   "name": "terminal: wait timeout above the maximum",
   "steps": [
    {
     "tool": "terminal",
     "arguments": {
      "action": "start",
      "command": "python"
     }
    },
    {
     "tool": "terminal",
     "arguments": {
      "action": "wait",
      "terminal_id": "$1.terminal_id",
      "timeout_ms": 30000
     }
    }
   ],
   "expect": {
    "ok": true
   }
  },
  {
   "name": "terminal: close alias",
   "steps": [
    {
     "tool": "terminal",
     "arguments": {
      "action": "start",
      "command": "python"
     }
    },
    {
     "tool": "terminal",
     "arguments": {
      "action": "close",
      "terminal_id": "$1.terminal_id"
     }
    }
   ],
   "expect": {
    "ok": true
   }
  },
  {
   "name": "terminal: input waits for the reply",
   "steps": [
    {
     "tool": "terminal",
     "arguments": {
      "action": "start",
      "command": "python",
      "args": [
       "-q"
      ]
     }
    },
    {
     "tool": "terminal",
     "arguments": {
      "action": "input",
      "terminal_id": "$1.terminal_id",
      "text": "print(6*7)",
      "key": "enter",
      "timeout_ms": 8000
     }
    }
   ],
   "expect": {
    "ok": true,
    "contains": [
