{
 "files": {
  "sub/marker.txt": "marker\n"
 },
 "cases": [
  {
   "name": "shell: canonical",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"print('hello there')\""
   },
   "expect": {
    "ok": true,
    "contains": [
     "hello there"
    ]
   }
  },
  {
   "name": "shell: cmd alias",
   "tool": "bash",
   "arguments": {
    "cmd": "python -c \"print('hello there')\""
   },
   "expect": {
    "ok": true,
    "contains": [
     "hello there"
    ]
   }
  },
  {
   "name": "shell: script alias",
   "tool": "bash",
   "arguments": {
    "script": "python -c \"print('hello there')\""
   },
   "expect": {
    "ok": true,
    "contains": [
     "hello there"
    ]
   }
  },
  {
   "name": "shell: argv array (Codex)",
   "tool": "bash",
   "arguments": {
    "command": [
     "python",
     "-c",
     "print('argv ok')"
    ]
   },
   "expect": {
    "ok": true,
    "contains": [
     "argv ok"
    ]
   }
  },
  {
   "name": "shell: commands list runs in order",
   "tool": "bash",
   "arguments": {
    "commands": [
     "python -c \"print('first step')\"",
     "python -c \"print('second step')\""
    ]
   },
   "expect": {
    "ok": true,
    "contains": [
     "first step",
     "second step"
    ]
   }
  },
  {
   "name": "shell: cwd alias",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"import os; print(os.listdir('.'))\"",
    "cwd": "sub"
   },
   "expect": {
    "ok": true,
    "contains": [
     "marker.txt"
    ]
   }
  },
  {
   "name": "shell: directory alias (Gemini)",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"import os; print(os.listdir('.'))\"",
    "directory": "sub",
    "description": "list sub"
   },
   "expect": {
    "ok": true,
    "contains": [
     "marker.txt"
    ]
   }
  },
  {
   "name": "shell: working_directory alias",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"import os; print(os.listdir('.'))\"",
    "working_directory": "sub"
   },
   "expect": {
    "ok": true,
    "contains": [
     "marker.txt"
    ]
   }
  },
  {
   "name": "shell: timeout_ms",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"print('hello there')\"",
    "timeout_ms": 60000
   },
   "expect": {
    "ok": true,
    "contains": [
     "hello there"
    ],
    "absent": [
     "milliseconds"
    ]
   }
  },
  {
   "name": "shell: timeout given in ms is read as ms with a note",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"print('hello there')\"",
    "timeout": 120000
   },
   "expect": {
    "ok": true,
    "contains": [
     "hello there",
     "milliseconds"
    ]
   }
  },
  {
   "name": "shell: background true",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"import time; time.sleep(1)\"",
    "background": true
   },
   "expect": {
    "ok": true,
    "contains": [
     "status: running",
     "command_id: cmd_",
     "background_tasks"
    ],
    "absent": [
     "terminal_id"
    ]
   }
  },
  {
   "name": "shell: run_in_background (Claude Code)",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"import time; time.sleep(1)\"",
    "run_in_background": true,
    "description": "short sleep"
   },
   "expect": {
    "ok": true,
    "contains": [
     "status: running",
     "command_id: cmd_",
     "background_tasks"
    ],
    "absent": [
     "terminal_id"
    ]
   }
  },
  {
   "name": "shell: is_background with explanation (Cursor)",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"print('hello there')\"",
    "is_background": false,
    "explanation": "print a greeting"
   },
   "expect": {
    "ok": true,
    "contains": [
     "hello there"
    ]
   }
  },
  {
   "name": "shell: mode auto means foreground",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"print('hello there')\"",
    "mode": "auto"
   },
   "expect": {
    "ok": true,
    "contains": [
     "hello there"
    ]
   }
  },
  {
   "name": "shell: background conflicts with mode",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"print('hello there')\"",
    "mode": "foreground",
    "background": true
   },
   "expect": {
    "ok": false,
    "contains": [
     "mode asks for foreground but background asks for background"
    ]
   }
  },
  {
   "name": "shell: mode background is read as run_in_background",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"import time; time.sleep(1)\"",
    "mode": "background"
   },
   "expect": {
    "ok": true,
    "contains": [
     "status: running",
     "command_id: cmd_"
    ]
   }
  },
  {
   "name": "shell: unknown mode is refused with run_in_background",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"print('hello there')\"",
    "mode": "turbo"
   },
   "expect": {
    "ok": false,
    "contains": [
     "is not a mode",
     "run_in_background"
    ]
   }
  },
  {
   "name": "shell: empty env_keys",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"print('hello there')\"",
    "env_keys": []
   },
   "expect": {
    "ok": true,
    "contains": [
     "hello there"
    ]
   }
  },
  {
   "name": "shell: env_keys naming an inherited variable",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"print('hello there')\"",
    "env_keys": [
     "PATH"
    ]
   },
   "expect": {
    "ok": true,
    "contains": [
     "hello there",
     "inherit"
    ]
   }
  },
  {
   "name": "shell: env_keys naming an unknown credential",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"print('hello there')\"",
    "env_keys": [
     "VBOT_PROBE_MISSING_KEY"
    ]
   },
   "expect": {
    "ok": false,
    "contains": [
     "VBOT_PROBE_MISSING_KEY",
     "not granted to this Agent"
    ],
    "absent": [
     "hello there"
    ]
   }
  },
  {
   "name": "shell: env object sets a plain variable",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"import os; print(os.environ['PROBE_GREETING'])\"",
    "env": {
     "PROBE_GREETING": "hi from env"
    }
   },
   "expect": {
    "ok": true,
    "contains": [
     "hi from env"
    ]
   }
  },
  {
   "name": "shell: env object refuses a literal secret",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"print('hello there')\"",
    "env": {
     "PROBE_API_TOKEN": "abc123secret"
    }
   },
   "expect": {
    "ok": false,
    "contains": [
     "credential values written in Tool calls"
    ],
    "absent": [
     "abc123secret",
     "hello there"
    ]
   }
  },
  {
   "name": "shell: local_shell action wrapper (OpenAI)",
   "tool": "bash",
   "arguments": {
    "action": {
     "type": "exec",
     "command": [
      "python",
      "-c",
      "import os; print(os.listdir('.'))"
     ],
     "working_directory": "sub",
     "timeout_ms": 30000,
     "env": {}
    }
   },
   "expect": {
    "ok": true,
    "contains": [
     "marker.txt"
    ]
   }
  },
  {
   "name": "shell: pty flag runs with a note",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"print('hello there')\"",
    "pty": true
   },
   "expect": {
    "ok": true,
    "contains": [
     "hello there",
     "pty has no effect"
    ]
   }
  },
  {
   "name": "shell: timeout moves the command to the background",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"import time; time.sleep(5)\"",
    "timeout": 1
   },
   "expect": {
    "ok": true,
    "contains": [
     "status: running",
     "still running at its 1-second timeout and continues in the background as cmd_"
    ],
    "absent": [
     "status: stopped"
    ]
   }
  },
  {
   "name": "shell: non-zero exit is ok and carries the exit code",
   "tool": "bash",
   "arguments": {
    "command": "python -c \"import sys; print('about to fail'); sys.exit(3)\""
   },
   "expect": {
    "ok": true,
    "contains": [
     "status: exited",
     "exit_code: 3",
     "about to fail"
    ],
    "absent": [
     "failed_programs"
    ]
   }
  },
  {
   "name": "background_tasks: status of a background command that ended",
   "steps": [
    {
     "tool": "bash",
     "arguments": {
      "command": "python -c \"import time; time.sleep(1); print('work done')\"",
      "run_in_background": true
     }
    },
    {
     "tool": "bash",
     "arguments": {
      "command": "python -c \"import time; time.sleep(3)\""
     }
    },
    {
     "tool": "background_tasks",
     "arguments": {
      "action": "status",
      "id": "$1.command_id"
     }
    }
   ],
   "expect": {
    "ok": true,
    "contains": [
     "status: exited",
     "exit_code: 0",
     "work done"
    ]
   }
  },
  {
   "name": "background_tasks: status shows a running server's newest output",
   "steps": [
    {
     "tool": "bash",
     "arguments": {
      "command": "python -c \"import time; print('server ready'); time.sleep(20)\"",
      "run_in_background": true
     }
    },
    {
     "tool": "bash",
     "arguments": {
      "command": "python -c \"import time; time.sleep(2)\""
     }
    },
    {
     "tool": "background_tasks",
     "arguments": {
      "action": "status",
      "id": "$1.command_id"
     }
    }
   ],
   "expect": {
    "ok": true,
    "contains": [
     "status: running",
     "server ready",
     "keeps running"
    ]
   }
  },
  {
   "name": "background_tasks: list shows a running background command",
   "steps": [
    {
     "tool": "bash",
     "arguments": {
      "command": "python -c \"import time; time.sleep(20)\"",
      "run_in_background": true
     }
    },
    {
     "tool": "background_tasks",
     "arguments": {
      "action": "list"
     }
    }
   ],
   "expect": {
    "ok": true,
    "contains": [
     "cmd_",
     "running"
    ]
   }
  },
  {
   "name": "background_tasks: stop a background command",
   "steps": [
    {
     "tool": "bash",
     "arguments": {
      "command": "python -c \"import time; time.sleep(30)\"",
      "run_in_background": true
     }
    },
    {
     "tool": "background_tasks",
     "arguments": {
      "action": "stop",
      "id": "$1.command_id"
     }
    }
   ],
   "expect": {
    "ok": true,
    "contains": [
     "status: stopped",
     "you stopped it."
    ]
   }
  },
  {
   "name": "background_tasks: KillShell shape without action only looks",
   "steps": [
    {
     "tool": "bash",
     "arguments": {
      "command": "python -c \"import time; time.sleep(30)\"",
      "run_in_background": true
     }
    },
    {
     "tool": "background_tasks",
     "arguments": {
      "shell_id": "$1.command_id"
     }
    }
   ],
   "expect": {
    "ok": true,
    "contains": [
     "status: running",
     "action is missing, so the status is shown"
    ]
   }
  },
  {
   "name": "background_tasks: wait is refused",
   "steps": [
    {
     "tool": "bash",
     "arguments": {
      "command": "python -c \"import time; time.sleep(30)\"",
      "run_in_background": true
     }
    },
    {
     "tool": "background_tasks",
     "arguments": {
      "action": "wait",
      "id": "$1.command_id",
      "timeout": 600
     }
    }
   ],
   "expect": {
    "ok": false,
    "contains": [
     "nothing to wait for"
    ]
   }
  },
  {
   "name": "background_tasks: input is refused",
   "steps": [
    {
     "tool": "bash",
     "arguments": {
      "command": "python -c \"import time; time.sleep(30)\"",
      "run_in_background": true
     }
    },
    {
     "tool": "background_tasks",
     "arguments": {
      "action": "input",
      "id": "$1.command_id",
      "text": "y"
     }
    }
   ],
   "expect": {
    "ok": false,
    "contains": [
     "background commands get no input"
    ]
   }
  },
  {
   "name": "terminal: refuses a background command's id",
   "steps": [
    {
     "tool": "bash",
     "arguments": {
      "command": "python -c \"import time; time.sleep(30)\"",
      "run_in_background": true
     }
    },
    {
     "tool": "terminal",
     "arguments": {
      "action": "status",
      "terminal_id": "$1.command_id"
     }
    }
   ],
   "expect": {
    "ok": false,
    "contains": [
