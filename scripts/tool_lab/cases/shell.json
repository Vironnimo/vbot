  {
   "name": "terminal: unknown id lists attached terminals",
   "steps": [
    {
     "tool": "terminal",
     "arguments": {
      "action": "start",
      "command": "python",
      "args": [
       "-q"
      ]
     }
    },
    {
     "tool": "terminal",
