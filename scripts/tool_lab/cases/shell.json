     "exit_code: 0"
    ]
   }
  },
  {
   "name": "process: wait for an output pattern",
   "steps": [
    {
     "tool": "bash",
     "arguments": {
      "command": "python -u -c \"import time; print('server ready'); time.sleep(20)\"",
      "mode": "background"
     }
    },
    {
     "tool": "process",
     "arguments": {
      "action": "wait",
      "process_id": "$1.process_id",
      "pattern": "ready"
     }
    }
   ],
   "expect": {
    "ok": true,
    "contains": [
     "server ready",
     "running"
    ]
