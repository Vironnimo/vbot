   "name": "process: wait for a background command",
   "steps": [
    {
     "tool": "bash",
     "arguments": {
      "command": "python -c \"import time; time.sleep(1); print('work done')\"",
      "mode": "background"
     }
    },
    {
     "tool": "process",
     "arguments": {
      "action": "wait",
      "process_id": "$1.process_id"
     }
    }
   ],
