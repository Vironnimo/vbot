  {
   "name": "terminal: Codex write_stdin shape",
   "steps": [
    {
     "tool": "terminal",
     "arguments": {
      "action": "start",
      "command": "python",
      "args": [
       "-q"
      ]
     }
    },
    {
     "tool": "terminal",
     "arguments": {
      "action": "write_stdin",
