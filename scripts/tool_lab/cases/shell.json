    ]
   }
  },
  {
   "name": "terminal: key spelling Ctrl+C",
   "steps": [
    {
     "tool": "terminal",
     "arguments": {
      "action": "start",
      "command": "python"
     }
    },
    {
     "tool": "terminal",
     "arguments": {
      "action": "input",
      "terminal_id": "$1.terminal_id",
      "key": "Ctrl+C"
     }
    }
   ],
   "expect": {
    "ok": true,
    "contains": [
