      "when": "2031-04-10",
      "duration": 60
     }
    }
   ],
   "expect": {
    "ok": true,
    "contains": [
     "free: 2",
     "2031-04-10T00:00 to 2031-04-10T15:00 (15h)",
     "2031-04-10T16:00 to 2031-04-11T00:00 (8h)"
    ]
   }
  },
  {
   "name": "calendar: add an Agent action before an event",
   "steps": [
    {
     "tool": "calendar",
     "arguments": {
      "action": "create",
      "title": "Dentist",
      "start": "2030-01-10T15:00"
     }
    },
    {
     "tool": "calendar",
     "arguments": {
      "action": "add_action",
      "id": "$1.id",
      "when": "start - 1h",
      "prompt": "Remind the user to leave for the dentist."
     }
    }
   ],
   "expect": {
    "ok": true,
    "contains": [
