{
 "files": {},
 "cases": [
  {
   "name": "cron: canonical recurring create",
   "tool": "cron",
   "arguments": {
    "action": "create",
    "name": "Build check",
    "prompt": "Check the nightly build status and summarize failures.",
    "schedule": "0 9 * * *"
   },
   "expect": {
    "ok": true,
    "contains": [
     "status: active",
     "schedule: 0 9 * * *",
     "target: main",
     "next_run: 20"
    ],
    "absent": [
     "Check the nightly build"
    ]
   }
  },
  {
   "name": "cron: canonical one-time create",
   "tool": "cron",
   "arguments": {
    "action": "create",
    "prompt": "Remind the user to stretch.",
    "schedule": "in 30m"
   },
   "expect": {
    "ok": true,
    "contains": [
     "status: active",
     "schedule: 20"
    ]
   }
  },
