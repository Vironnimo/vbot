   }
  },
  {
   "name": "cron: list shows a created job",
   "steps": [
    {
     "tool": "cron",
     "arguments": {
      "action": "create",
      "name": "Digest",
      "prompt": "Write the daily digest.",
      "schedule": "0 8 * * *"
     }
    },
    {
     "tool": "cron",
     "arguments": {
      "action": "list"
     }
    }
   ],
   "expect": {
    "ok": true,
    "contains": [
     "name: Digest",
     "prompt: Write the daily digest.",
     "schedule: 0 8 * * *"
    ]
   }
  },
  {
   "name": "cron: update the schedule",
   "steps": [
    {
     "tool": "cron",
     "arguments": {
      "action": "create",
      "prompt": "Check the queue.",
      "schedule": "every 2h"
     }
    },
    {
