#include <windows.h>

#ifndef VBOT_ICON_PATH
#define VBOT_ICON_PATH "../../desktop/icon.ico"
#endif
#ifndef VBOT_FILE_VERSION
#define VBOT_FILE_VERSION 0,0,0,0
#endif
#ifndef VBOT_FILE_VERSION_STRING
#define VBOT_FILE_VERSION_STRING "0.0.0.0"
#endif
#ifndef VBOT_PRODUCT_NAME
#define VBOT_PRODUCT_NAME "vBot"
#endif
#ifndef VBOT_MANIFEST_PATH
#define VBOT_MANIFEST_PATH "launcher.manifest"
#endif

1 ICON VBOT_ICON_PATH
1 RT_MANIFEST VBOT_MANIFEST_PATH
1 VERSIONINFO
 FILEVERSION VBOT_FILE_VERSION
 PRODUCTVERSION VBOT_FILE_VERSION
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "The vBot Authors\0"
   VALUE "FileDescription", VBOT_PRODUCT_NAME " native host\0"
   VALUE "FileVersion", VBOT_FILE_VERSION_STRING "\0"
   VALUE "InternalName", VBOT_PRODUCT_NAME "\0"
   VALUE "LegalCopyright", "Copyright (c) The vBot Authors\0"
   VALUE "OriginalFilename", VBOT_PRODUCT_NAME ".exe\0"
   VALUE "ProductName", "vBot\0"
   VALUE "ProductVersion", VBOT_FILE_VERSION_STRING "\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
